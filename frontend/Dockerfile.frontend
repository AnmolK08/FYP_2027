FROM node:20-alpine as build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
# Note: In a real app, you'd want a custom nginx.conf to handle React Router history fallback
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
