// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  password           String
  name               String
  college            String?
  department         String?
  leetcodeUsername   String?  @map("leetcode_username")
  avatar             String?
  dailyGoal          Int      @default(3) @map("daily_goal")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  leetcodeStats      LeetcodeStats?
  activities         Activity[]
  chatMessages       ChatMessage[]
  knowledgeDocs      KnowledgeDoc[]
  mockInterviews     MockInterview[]
  flashcards         Flashcard[]
  routines           Routine[]
  routineDays        RoutineDay[]
  routineTaskLogs    RoutineTaskLog[]

  @@map("users")
}

model LeetcodeStats {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  leetcodeUsername String? @map("leetcode_username")
  realName         String?  @map("real_name")
  avatar           String?
  totalSolved      Int      @default(0) @map("total_solved")
  easy             Int      @default(0)
  medium           Int      @default(0)
  hard             Int      @default(0)
  contestRating    Float    @default(0) @map("contest_rating")
  contestsAttended Int      @default(0) @map("contests_attended")
  globalRanking    Int      @default(0) @map("global_ranking")
  topPercentage    Float    @default(0) @map("top_percentage")
  tags             Json?
  ratingHistory    Json?    @map("rating_history")
  submissionCalendar Json?  @map("submission_calendar")
  streak           Int      @default(0)
  activeDays       Int      @default(0) @map("active_days")
  universalScore   Float    @default(0) @map("universal_score")
  lastSynced       DateTime? @map("last_synced")
  createdAt        DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("leetcode_stats")
}

model Activity {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  date          String
  checkedIn     Boolean  @default(false) @map("checked_in")
  synced        Boolean  @default(false)
  solvedSnapshot Int    @default(0) @map("solved_snapshot")
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, date])
  @@map("activity")
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  sessionId String   @map("session_id")
  role      String
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, sessionId])
  @@map("chat_messages")
}

model KnowledgeDoc {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  filename  String
  size      Int      @default(0)
  chunks    Json?
  nChunks   Int      @default(0) @map("n_chunks")
  createdAt DateTime @default(now()) @map("created_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcards Flashcard[]

  @@map("knowledge_docs")
}

model MockInterview {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  type               String
  problemTitle       String   @map("problem_title")
  problemDescription String? @map("problem_description")
  starterCode        String? @map("starter_code")
  language           String   @default("javascript")
  durationMinutes    Int      @default(30) @map("duration_minutes")
  status             String   @default("pending")
  code               String?
  score              Int?
  feedback           Json?
  startedAt          DateTime? @map("started_at")
  completedAt        DateTime? @map("completed_at")
  createdAt          DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("mock_interviews")
}

model Flashcard {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  documentId  String   @map("document_id")
  question    String   @db.Text
  answer      String   @db.Text
  difficulty  String   @default("medium")
  sourceChunk Int?     @map("source_chunk")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  document KnowledgeDoc @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([documentId])
  @@map("flashcards")
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TaskStatus {
  PENDING
  COMPLETED
  SKIPPED
}

model Routine {
  id          String        @id @default(uuid())
  userId      String        @map("user_id")
  name        String
  description String?
  isActive    Boolean       @default(false) @map("is_active")
  isArchived  Boolean       @default(false) @map("is_archived")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       RoutineTask[]
  routineDays RoutineDay[]

  @@index([userId])
  @@index([userId, isActive])
  @@map("routines")
}

model RoutineTask {
  id          String        @id @default(uuid())
  routineId   String        @map("routine_id")
  title       String
  description String?
  startTime   String        @map("start_time")
  endTime     String        @map("end_time")
  category    String        @default("general")
  daysOfWeek  DayOfWeek[]   @map("days_of_week")
  priority    Int           @default(1)
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  routine     Routine          @relation(fields: [routineId], references: [id], onDelete: Cascade)
  taskLogs    RoutineTaskLog[]

  @@index([routineId])
  @@index([routineId, isActive])
  @@map("routine_tasks")
}

model RoutineDay {
  id                   String           @id @default(uuid())
  userId               String           @map("user_id")
  routineId            String           @map("routine_id")
  date                 DateTime         @db.Date
  completionPercentage Float            @default(0) @map("completion_percentage")
  completedTasks       Int              @default(0) @map("completed_tasks")
  totalTasks           Int              @default(0) @map("total_tasks")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  routine  Routine          @relation(fields: [routineId], references: [id], onDelete: Cascade)
  taskLogs RoutineTaskLog[]

  @@unique([userId, routineId, date])
  @@index([userId, date])
  @@map("routine_days")
}

model RoutineTaskLog {
  id                 String      @id @default(uuid())
  routineDayId       String      @map("routine_day_id")
  routineTaskId      String?     @map("routine_task_id")
  userId             String      @map("user_id")
  taskTitleSnapshot  String      @map("task_title_snapshot")
  startTimeSnapshot  String      @map("start_time_snapshot")
  endTimeSnapshot    String      @map("end_time_snapshot")
  status             TaskStatus  @default(PENDING)
  completedAt        DateTime?   @map("completed_at")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  routineDay  RoutineDay   @relation(fields: [routineDayId], references: [id], onDelete: Cascade)
  routineTask RoutineTask? @relation(fields: [routineTaskId], references: [id], onDelete: SetNull)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([routineDayId])
  @@index([routineTaskId])
  @@index([userId])
  @@index([userId, createdAt])
  @@map("routine_task_logs")
}



