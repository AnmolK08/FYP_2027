PORT=
NODE_ENV=

# Database Configuration
DATABASE_URL=

# Redis Configuration
REDIS_URL=

# JWT Secrets
JWT_SECRET="your_super_secret_jwt_key_here"
JWT_EXPIRES_IN=

# Pinecone Configuration
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
# Namespace for vector operations. Use "development" or "production" per environment.
# User isolation is handled via metadata filters, not separate namespaces.
PINECONE_NAMESPACE=

# Gemini Configuration 

GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=

# RAG Configuration 
# Number of top results to retrieve from Pinecone. Default: 5
RAG_TOP_K=
# Minimum similarity score threshold. Results below this are discarded. Default: 0.65
RAG_MIN_SCORE=
# Maximum characters in the context block sent to Gemini. Default: 12000
RAG_MAX_CONTEXT_CHARS=
# Document chunking parameters for RecursiveCharacterTextSplitter.
RAG_CHUNK_SIZE=
RAG_CHUNK_OVERLAP=
