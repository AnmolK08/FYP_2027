PORT=
NODE_ENV=

# Database Configuration
DATABASE_URL=

# Redis Configuration
REDIS_URL=

# JWT Secrets
JWT_SECRET="your_super_secret_jwt_key_here"
JWT_EXPIRES_IN=

# Pinecone Configuration
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
# Namespace for vector operations. Use "development" or "production" per environment.
# User isolation is handled via metadata filters, not separate namespaces.
PINECONE_NAMESPACE=

# Gemini Configuration 

GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=

# RAG Configuration 
# Number of top results to retrieve from Pinecone. Default: 5
RAG_TOP_K=
# Minimum similarity score threshold. Results below this are discarded. Default: 0.65
RAG_MIN_SCORE=
# Maximum characters in the context block sent to Gemini. Default: 12000
RAG_MAX_CONTEXT_CHARS=
# Document chunking parameters for RecursiveCharacterTextSplitter.
RAG_CHUNK_SIZE=
RAG_CHUNK_OVERLAP=

# ─── Daily Platform Sync Cron ────────────────────────────────────────────────
# Cron schedule (node-cron syntax). Default: every day at 4:00 AM IST (22:30 UTC previous day).
CRON_SCHEDULE=
# IANA timezone for the cron schedule. Default: Asia/Kolkata (IST).
CRON_TIMEZONE=
# Number of users to fetch from DB per page. Default: 100.
CRON_BATCH_SIZE=
# Max concurrent LeetCode API requests (GraphQL). Default: 5.
CRON_LC_CONCURRENCY=
# Delay (ms) between each Codeforces API user-status call. Default: 2100ms (CF limit: 1 req/2s).
CRON_CF_DELAY_MS=
# Max retry attempts for transient API failures (429/5xx). Default: 3.
CRON_RETRY_COUNT=
# Base delay (ms) for exponential backoff on retries. Default: 5000.
CRON_RETRY_BASE_DELAY_MS=
# Redis distributed lock TTL (seconds). Default: 7200 (2 hours — safe upper bound).
CRON_LOCK_TTL=
